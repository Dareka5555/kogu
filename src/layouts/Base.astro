---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Kogu(小具)— 貼り付けるだけ、ブラウザだけで完結する開発者向け小ツール集。入力は送信されません。"
    />
    <title>{title}</title>
  </head>
  <body class="text-gray-900">
    <header class="border-b border-gray-200">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
        <a href="/" class="text-lg font-bold">
          Kogu(小具)
        </a>
        <nav>
          <a href="/" class="text-sm text-gray-600 hover:underline">
            ツール一覧
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-gray-200">
      <div class="mx-auto max-w-3xl px-4 py-6 text-center">
        <p class="text-sm text-gray-500">
          入力はすべてブラウザ内で処理されます
        </p>
        <nav class="mt-2 flex justify-center gap-4 text-sm">
          <a href="/about" class="text-gray-600 hover:underline">
            このサイトについて
          </a>
          <a href="/privacy" class="text-gray-600 hover:underline">
            プライバシーポリシー
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
